{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "760px",
			"wideSize": "1320px"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"custom": false,
			"palette": [
				{
					"slug": "ink",
					"color": "#0C0B0A",
					"name": "Ink"
				},
				{
					"slug": "coal",
					"color": "#171514",
					"name": "Coal"
				},
				{
					"slug": "smoke",
					"color": "#232020",
					"name": "Smoke"
				},
				{
					"slug": "pearl",
					"color": "#EFE6D6",
					"name": "Pearl"
				},
				{
					"slug": "ash",
					"color": "#9C8F82",
					"name": "Muted text"
				},
				{
					"slug": "line",
					"color": "#2C2624",
					"name": "Hairline"
				},
				{
					"slug": "terracotta",
					"color": "#B5501F",
					"name": "Terracotta"
				},
				{
					"slug": "seam",
					"color": "#E8D6A6",
					"name": "Seam"
				},
				{
					"slug": "terracotta-deep",
					"color": "#8C3A15",
					"name": "Terracotta, deep"
				}
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fluid": true,
			"fontFamilies": [
				{
					"slug": "display",
					"name": "Display",
					"fontFamily": "'Cormorant Garamond', Georgia, 'Times New Roman', serif"
				},
				{
					"slug": "body",
					"name": "Body",
					"fontFamily": "Jost, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif"
				}
			],
			"fontSizes": [
				{
					"slug": "small",
					"name": "Small",
					"size": "0.875rem"
				},
				{
					"slug": "medium",
					"name": "Medium",
					"size": "1.0625rem"
				},
				{
					"slug": "large",
					"name": "Large",
					"size": "1.25rem",
					"fluid": {
						"min": "1.125rem",
						"max": "1.375rem"
					}
				},
				{
					"slug": "x-large",
					"name": "Extra large",
					"size": "2rem",
					"fluid": {
						"min": "1.5rem",
						"max": "2.25rem"
					}
				},
				{
					"slug": "xx-large",
					"name": "Section heading",
					"size": "3.25rem",
					"fluid": {
						"min": "2rem",
						"max": "3.75rem"
					}
				},
				{
					"slug": "display",
					"name": "Display",
					"size": "5.5rem",
					"fluid": {
						"min": "2.75rem",
						"max": "6.5rem"
					}
				}
			]
		},
		"spacing": {
			"units": [
				"px",
				"em",
				"rem",
				"vh",
				"vw",
				"%"
			],
			"spacingSizes": [
				{
					"slug": "20",
					"name": "1",
					"size": "clamp(0.75rem, 2vw, 1rem)"
				},
				{
					"slug": "30",
					"name": "2",
					"size": "clamp(1rem, 3vw, 1.5rem)"
				},
				{
					"slug": "40",
					"name": "3",
					"size": "clamp(1.5rem, 4vw, 2.25rem)"
				},
				{
					"slug": "50",
					"name": "4",
					"size": "clamp(2.25rem, 6vw, 3.5rem)"
				},
				{
					"slug": "60",
					"name": "5",
					"size": "clamp(3.5rem, 9vw, 6rem)"
				},
				{
					"slug": "70",
					"name": "6",
					"size": "clamp(5rem, 12vw, 8.5rem)"
				}
			]
		},
		"border": {
			"radius": true,
			"color": true,
			"style": true,
			"width": true
		},
		"custom": {
			"radius": "4px",
			"hairline": "1px solid var(--wp--preset--color--line)"
		}
	},
	"styles": {
		"color": {
			"background": "var:preset|color|ink",
			"text": "var:preset|color|pearl"
		},
		"typography": {
			"fontFamily": "var:preset|font-family|body",
			"fontSize": "var:preset|font-size|medium",
			"lineHeight": "1.65",
			"fontWeight": "300"
		},
		"spacing": {
			"blockGap": "var:preset|spacing|40",
			"padding": {
				"left": "var:preset|spacing|30",
				"right": "var:preset|spacing|30"
			}
		},
		"elements": {
			"link": {
				"color": {
					"text": "var:preset|color|pearl"
				},
				"typography": {
					"textDecoration": "underline"
				},
				":hover": {
					"color": {
						"text": "var:preset|color|terracotta"
					}
				}
			},
			"heading": {
				"typography": {
					"fontFamily": "var:preset|font-family|display",
					"fontWeight": "300",
					"lineHeight": "1.08",
					"letterSpacing": "-0.01em"
				},
				"color": {
					"text": "var:preset|color|pearl"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var:preset|font-size|display"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var:preset|font-size|xx-large"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var:preset|font-size|x-large"
				}
			},
			"h4": {
				"typography": {
					"fontFamily": "var:preset|font-family|body",
					"fontSize": "var:preset|font-size|large",
					"fontWeight": "500",
					"letterSpacing": "0"
				}
			},
			"button": {
				"color": {
					"background": "var:preset|color|terracotta",
					"text": "var:preset|color|pearl"
				},
				"typography": {
					"fontFamily": "var:preset|font-family|body",
					"fontSize": "var:preset|font-size|small",
					"fontWeight": "500",
					"letterSpacing": "0.14em",
					"textTransform": "uppercase"
				},
				"spacing": {
					"padding": {
						"top": "16px",
						"bottom": "16px",
						"left": "34px",
						"right": "34px"
					}
				},
				"border": {
					"radius": "2px"
				},
				":hover": {
					"color": {
						"background": "var:preset|color|pearl",
						"text": "var:preset|color|ink"
					}
				}
			}
		},
		"blocks": {
			"core/image": {
				"border": {
					"radius": "2px"
				}
			},
			"core/gallery": {
				"spacing": {
					"blockGap": "6px"
				}
			},
			"core/separator": {
				"color": {
					"text": "var:preset|color|line"
				}
			},
			"core/quote": {
				"typography": {
					"fontFamily": "var:preset|font-family|display",
					"fontSize": "var:preset|font-size|x-large",
					"fontWeight": "300",
					"lineHeight": "1.35"
				}
			},
			"core/details": {
				"spacing": {
					"padding": {
						"top": "var:preset|spacing|30",
						"bottom": "var:preset|spacing|30"
					}
				}
			}
		}
	},
	"templateParts": [
		{
			"name": "header",
			"title": "Header",
			"area": "header"
		},
		{
			"name": "footer",
			"title": "Footer",
			"area": "footer"
		}
	],
	"customTemplates": [
		{
			"name": "page-service",
			"title": "Service page",
			"postTypes": [
				"page"
			]
		},
		{
			"name": "page-pricing",
			"title": "Pricing page",
			"postTypes": [
				"page"
			]
		},
		{
			"name": "page-book",
			"title": "Booking page",
			"postTypes": [
				"page"
			]
		},
		{
			"name": "page-private",
			"title": "Private access page",
			"postTypes": [
				"page"
			]
		}
	]
}
