{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "newbrand/breadcrumbs",
	"title": "Breadcrumbs",
	"category": "theme",
	"icon": "arrow-right-alt2",
	"description": "The trail from the home page to this one. Matches the BreadcrumbList structured data the theme sends to Google.",
	"textdomain": "newbrand",
	"keywords": [ "breadcrumb", "navigation", "seo" ],
	"supports": {
		"html": false,
		"reusable": false,
		"multiple": false,
		"spacing": { "margin": true, "padding": true },
		"typography": { "fontSize": true, "__experimentalFontFamily": true },
		"color": { "text": true, "background": false, "link": true }
	},
	"editorScript": "file:./index.js",
	"render": "file:./render.php"
}
